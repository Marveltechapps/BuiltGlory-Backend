{
  "name": "builtglory-backend",
  "version": "1.0.0",
  "description": "Production-ready BuiltGlory Node.js Express MongoDB backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:tunnel": "node scripts/dev-cloudflare-tunnel.mjs",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "npm test -- --coverage",
    "openapi": "node src/docs/write-openapi.js",
    "jobs:run": "node src/jobs/runner.js",
    "push:check": "node scripts/push-check.js",
    "seed": "node scripts/seed.js",
    "seed:push": "node scripts/seed-push-notification-test-data.js",
    "test:push-api": "node scripts/run-push-notification-tests.js",
    "migrate": "node scripts/migrate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.1.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
  "nodemonConfig": {
    "delay": 500,
    "signal": "SIGTERM",
    "watch": [
      "src"
    ],
    "ext": "js,json",
    "ignore": [
      "src/tests/**",
      "coverage/**",
      "scripts/**"
    ]
  }
}
