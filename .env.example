# Copy to .env and fill in values. Never commit .env to version control.

# Server
NODE_ENV=development
PORT=5001

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/builtglory

# Firebase Cloud Messaging (use either service account file OR inline credentials)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Optional push provider fallback when Firebase is not configured
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=

# Official company support contact (used in defaults and public app config)
COMPANY_SUPPORT_PHONE=+91 8667769670
# Optional override for WhatsApp digits (defaults to support phone without +)
# COMPANY_WHATSAPP_NUMBER=918667769670

# Phone OTP SMS (Spear UC / custom gateway)
# SMS_DELIVERY_MODE=vendor|log
#   vendor = real SMS (required for production OTP delivery)
#   log    = non-production only; does NOT send SMS
SMS_DELIVERY_MODE=vendor
# SMS_VENDOR_URL=...  (optional; falls back to config.json smsvendor)
# Must match the DLT-approved template for sender/t_id in config.json:
SMS_OTP_MESSAGE_TEMPLATE=Dear Applicant, Your OTP for Mobile No. Verification is {otp} . MJPTBCWREIS - EVOLGN
# SMS_PROVIDER_URL=
# SMS_PROVIDER_TOKEN=
