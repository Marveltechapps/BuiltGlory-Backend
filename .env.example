# Copy to .env and fill in values. Never commit .env to version control.

# Server
NODE_ENV=development
PORT=5001

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/builtglory

# Firebase Cloud Messaging (use either service account file OR inline credentials)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Optional push provider fallback when Firebase is not configured
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=

# Official company support contact (used in defaults and public app config)
COMPANY_SUPPORT_PHONE=+91 8667769670
COMPANY_SUPPORT_EMAIL=support@builtglory.com
# Optional override for WhatsApp digits (defaults to support phone without +)
# COMPANY_WHATSAPP_NUMBER=918667769670

# Phone OTP SMS (Spear UC / custom gateway)
# SMS_DELIVERY_MODE=vendor|log
#   vendor = real SMS (required for production OTP delivery)
#   log    = non-production only; does NOT send SMS
SMS_DELIVERY_MODE=vendor
# Base URL must end with &; runtime appends to_mobileno + sms_text
SMS_VENDOR_URL=https://login4.spearuc.com/MOBILE_APPS_API/sms_api.php?type=smsquicksend&user=builtglory&pass=Builtglory2026&sender=EVOLGN&
# Must match the DLT-approved template for sender EVOLGN:
SMS_OTP_MESSAGE_TEMPLATE=Dear Applicant, Your OTP for Mobile No. Verification is {otp} . MJPTBCWREIS - EVOLGN
# SMS_PROVIDER_URL=
# SMS_PROVIDER_TOKEN=

# Public property links / App Links / Universal Links
# Host this origin (or reverse-proxy it) so /p/:id and /.well-known/* resolve.
# APP_PUBLIC_URL=https://builtglory.app
# ANDROID_APPLICATION_ID=com.builtglory.builtglory
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...
# IOS_APP_ID=TEAMID.com.builtglory.builtglory
# APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.builtglory.builtglory
# APP_IOS_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID

